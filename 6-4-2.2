#include <stdio.h>

int main() {
    char X[1001];
    char Y[1001];
    char Z[101];

    int xcount = 0;
    int ycount = 0;

    char ch;

    while (1) {
        scanf("%c", &ch);

        if (ch == '!')
            break;

        X[xcount++] = ch;

        int found = 0;

        for (int i = 0; i < ycount; i++) {
            if (Y[i] == ch) {
                found = 1;
                break;
            }
        }

        if (!found)
            Y[ycount++] = ch;
    }

    Y[ycount] = '\0';
    printf("%s\n", Y);

    int M;
    scanf("%d", &M);

    getchar();

    for (int i = 0; i < M; i++) {
        scanf("%c", &Z[i]);
    }
    Z[M] = '\0';

    int pos = -1;

    for (int i = 0; i <= ycount - M; i++) {

        int same = 1;

        for (int j = 0; j < M; j++) {
            if (Y[i + j] != Z[j]) {
                same = 0;
                break;
            }
        }

        if (same) {
            pos = i;
            break;
        }
    }

    if (pos == -1)
        printf("none");
    else
        printf("%d", pos);

    return 0;
}
